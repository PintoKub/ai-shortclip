# Copy to .env and fill in YOUR OWN key. .env is git-ignored — never commit it.

# --- Claude (writer / planner / animator / cover ideas) ---
# Option A: Anthropic API key  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B: any gateway/proxy that speaks the Anthropic API (leave Option A empty)
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=your-gateway-key

# Option C: already logged in with `claude login` (Claude Pro/Max) -> leave everything empty.

# --- optional overrides ---
# CHROME=/path/to/chrome        # default: Playwright's Chromium
# FFMPEG=/path/to/ffmpeg
# SHORTCLIP_HOST=127.0.0.1      # 0.0.0.0 inside Docker
# SHORTCLIP_PORT=8099
# SHORTCLIP_INSECURE_COOKIE=1   # only if you serve the dashboard over plain http on a non-localhost host
